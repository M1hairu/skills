#!/usr/bin/env bash
# Ночная автономность прямо в идущей сессии: разрешения перестают её останавливать.
#
#   afk-autonomy --on      — включить для текущего каталога
#   afk-autonomy --off     — выключить
#   afk-autonomy --status  — включена ли сейчас
#
# Режим сессии (`manual`, `acceptEdits`) на ходу не меняется — он задаётся при запуске
# процесса. Зато хуки Claude Code перечитывает на лету, а хук `PreToolUse` умеет сам
# выдавать разрешение. Поэтому в `~/.claude/settings.local.json` ставится хук, который
# отвечает «allow» — но только для каталогов из `~/.local/state/afk/autonomy-dirs`.
# В остальных местах он молчит, и разрешения работают как обычно.
#
# Опасное хук отклоняет и ночью: ключи и учётные данные, `sudo`, форс-пуш, рекурсивное
# удаление вне проекта. Этим он лучше `--dangerously-skip-permissions`, где не действует
# даже `permissions.deny`.

set -euo pipefail

DIR="$PWD"
ACTION=""
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/afk"
DIRS_FILE="$STATE_DIR/autonomy-dirs"
SETTINGS="$HOME/.claude/settings.local.json"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --on|--off|--status) ACTION="${1#--}"; shift ;;
    --hook)   ACTION=hook; shift ;;
    --dir)    DIR="$(readlink -f "$2")"; shift 2 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "afk-autonomy: неизвестный флаг $1" >&2; exit 2 ;;
  esac
done

# ── решение по конкретному вызову инструмента ─────────────────────────────────
# Так скрипт зовёт сам Claude Code: на stdin JSON вызова, на stdout — вердикт.
# Молчание значит «решай как обычно», поэтому днём и в чужих каталогах хук ничего
# не меняет.
if [[ "$ACTION" == hook ]]; then
  # Код передаётся через -c, а не heredoc: stdin занят самим вызовом инструмента.
  exec python3 -c '
import json, os, re, sys

dirs_file = sys.argv[1]

try:
    event = json.load(sys.stdin)
except Exception:
    sys.exit(0)

cwd = event.get("cwd") or os.getcwd()
try:
    with open(dirs_file) as f:
        watched = [line.strip() for line in f if line.strip()]
except Exception:
    watched = []

if not any(cwd == d or cwd.startswith(d.rstrip("/") + "/") for d in watched):
    sys.exit(0)


def verdict(decision, reason):
    # Журнал решений: утром по нему видно, что хук отклонял ночью.
    try:
        if decision != "allow" or os.path.exists(os.path.join(cwd, ".afk", "hook.debug")):
            with open(os.path.join(cwd, ".afk", "hook.log"), "a") as log:
                log.write("{} {} {}\n".format(decision, event.get("tool_name", "?"), reason))
    except Exception:
        pass
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": decision,
        "permissionDecisionReason": reason,
    }}, ensure_ascii=False))
    sys.exit(0)


tool = event.get("tool_name", "")
data = event.get("tool_input") or {}

# Смотрим на то, с чем инструмент работает: путь к файлу и саму команду.
# Содержимое не проверяем — иначе ночью не написать ни скрипта, ни документации,
# где такой путь просто упомянут.
targets = " ".join(str(data.get(key, "")) for key in
                   ("file_path", "notebook_path", "path", "command", "pattern", "url"))

# Секреты: ночью их не читают и не правят, даже когда очень надо.
SECRETS = (r"\.ssh/", r"\.gnupg", r"\.aws/", r"\.netrc", r"\.git-credentials",
           r"\.credentials\.json", r"\.config/sing-box", r"id_(rsa|ed25519|ecdsa)")
for pattern in SECRETS:
    if re.search(pattern, targets):
        verdict("deny", "ключи и учётные данные ночью не трогаем — запиши в BLOCKED.md")

if tool == "Bash":
    command = str(data.get("command", ""))

    if re.search(r":\(\)\{.*\};:", command):
        verdict("deny", "форк-бомба — не ночью")

    # Опасное ищем среди исполняемых команд, а не по всей строке: ночью пишутся
    # скрипты и документация, где те же слова стоят просто текстом.
    DANGEROUS = (
        (r"^(sudo|doas)\b", "запуск от root"),
        (r"^(mkfs|dd)\b.*of=/dev/", "запись на устройство"),
        (r"^git\s+push\b.*(--force|-f)\b", "форс-пуш"),
        (r"^(shutdown|reboot|halt|poweroff)\b", "выключение машины"),
        (r"^systemctl\s+(poweroff|reboot|halt)\b", "выключение машины"),
    )
    for part in re.split(r"[;&|\n]+", command):
        part = part.strip().lstrip("(){ \t")
        if not part:
            continue
        for pattern, why in DANGEROUS:
            if re.search(pattern, part):
                verdict("deny", f"{why} — не ночью; опиши в BLOCKED.md и иди дальше")

        # Рекурсивно удалять можно только у себя в проекте и во временных файлах:
        # ошибка в пути ночью стоит чужих данных.
        if re.match(r"^rm\b", part) and re.search(r"\s-[a-zA-Z]*[rR]", part):
            home = os.path.expanduser("~").rstrip("/")
            outside = []
            for target in re.findall(r"(?<![\w/=])(~[^\s]*|/[^\s]*)", part):
                full = os.path.expanduser(target).rstrip("/")
                # Домашний каталог и всё, что лежит в нём непосредственно, — не
                # «файлы проекта», даже когда сессия запущена прямо из ~.
                if full == home or (full.startswith(home + "/")
                                    and full.count("/") - home.count("/") <= 1):
                    outside.append(target)
                elif not (full.startswith(cwd.rstrip("/") + "/") or full.startswith("/tmp/")):
                    outside.append(target)
            if outside:
                verdict("deny", f"рекурсивное удаление вне проекта ({outside[0]}) — не ночью")

verdict("allow", "режим AFK: разрешения не останавливают работу")
' "$DIRS_FILE"
fi

[[ -n "$ACTION" ]] || ACTION=status

SELF="$(readlink -f "$0")"
command -v afk-autonomy >/dev/null && SELF="afk-autonomy"

listed() { [[ -f "$DIRS_FILE" ]] && grep -qxF "$DIR" "$DIRS_FILE"; }

# Хук ставится один раз на пользователя и сам смотрит, в каком каталоге его позвали:
# проектные настройки сессия подхватывает не сразу, а пользовательские — на лету.
ensure_hook() {
  mkdir -p "$(dirname "$SETTINGS")"
  SELF="$SELF" python3 - "$SETTINGS" <<'PY'
import json, os, sys

path = sys.argv[1]
command = f"{os.environ['SELF']} --hook"
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    data = {}

groups = data.setdefault("hooks", {}).setdefault("PreToolUse", [])
if command in json.dumps(groups):
    sys.exit(0)

groups.append({"matcher": "*", "hooks": [{"type": "command", "command": command, "timeout": 10}]})
with open(path, "w") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
}

case "$ACTION" in
  on)
    mkdir -p "$STATE_DIR" "$DIR/.afk"
    listed || printf '%s\n' "$DIR" >> "$DIRS_FILE"
    ensure_hook
    echo "автономность включена: разрешения больше не останавливают работу в $DIR"
    echo "опасное (ключи, sudo, форс-пуш, rm -rf вне проекта) хук по-прежнему отклоняет"
    ;;

  off)
    if [[ -f "$DIRS_FILE" ]]; then
      grep -vxF "$DIR" "$DIRS_FILE" > "$DIRS_FILE.tmp" 2>/dev/null || true
      mv "$DIRS_FILE.tmp" "$DIRS_FILE"
    fi
    # Сам хук остаётся в настройках: без каталогов он молчит, а поставленный заранее
    # переживает начало следующей ночи — добавленный на лету сессия может не принять.
    echo "автономность выключена для $DIR"
    ;;

  status)
    if listed; then
      echo "автономность включена для $DIR"
      [[ -f "$DIR/.afk/hook.log" ]] && { echo "последнее отклонённое:"; tail -3 "$DIR/.afk/hook.log"; }
    else
      echo "автономность выключена для $DIR"
    fi
    ;;
esac
