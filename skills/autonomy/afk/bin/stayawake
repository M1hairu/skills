#!/usr/bin/env bash
# Не давать ноутбуку уснуть, пока идёт работа в другом окне.
#
#   stayawake            — держать бодрым, пока не нажмёшь Ctrl+C
#   stayawake 6h         — держать бодрым 6 часов, потом отпустить
#
# Нужен, когда сессия Claude Code уже запущена обычным `claude` и перезапускать
# её через `afk` не хочется: экран гаснет, но система не уходит в сон и не
# реагирует на закрытие крышки.
#
# Блокируем `sleep` и крышку, но не `idle`: с `idle` система считается занятой,
# и демон простоя (hypridle, swayidle, GNOME) не гасит экран и не блокирует сессию.

set -euo pipefail

DURATION="${1:-}"

if [[ -n "$DURATION" ]]; then
  echo "Ноутбук не уснёт ближайшие $DURATION (Ctrl+C — отпустить раньше)."
  exec systemd-inhibit \
    --what=sleep:handle-lid-switch \
    --who=stayawake --why="работа идёт без человека" \
    sleep "$DURATION"
fi

echo "Ноутбук не уснёт, пока это окно живо. Ctrl+C — отпустить."
exec systemd-inhibit \
  --what=sleep:handle-lid-switch \
  --who=stayawake --why="работа идёт без человека" \
  bash -c 'while :; do sleep 3600; done'
