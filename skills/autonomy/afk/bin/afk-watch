#!/usr/bin/env bash
# Сторож ночной сессии: поднимает работу, если она встала — кончился лимит
# подписки или оборвалась связь.
#
#   afk-watch --start    — приставить сторожа к текущему каталогу
#   afk-watch --status   — что он видит прямо сейчас
#   afk-watch --once     — одна проверка вслух, ничего не запуская
#   afk-watch --stop     — снять сторожа
#
# Живая сессия каждый виток трогает `.afk/heartbeat` (так велит afk-policy.md).
# Если файл не обновлялся дольше AFK_IDLE_MIN минут, сторож разбирается, почему:
# нет связи или выбрано пятичасовое окно — ждёт, иначе поднимает работу заново
# фоновой сессией с прежним контекстом. Недельный кап он не проедает: выше
# AFK_WEEKLY_FLOOR процентов работа не возобновляется, остаток остаётся человеку.

set -euo pipefail

SELF="$(readlink -f "$0")"
POLICY="${AFK_POLICY:-$HOME/.claude/afk-policy.md}"
IDLE_MIN="${AFK_IDLE_MIN:-30}"
WEEKLY_FLOOR="${AFK_WEEKLY_FLOOR:-90}"
MAX_RESUMES="${AFK_MAX_RESUMES:-6}"
CHECK_SEC="${AFK_CHECK_SEC:-300}"
MODE="${AFK_PERMISSION_MODE:-dontAsk}"

ACTION=""
DIR="$PWD"
DRY=1

RESUME_PROMPT="${AFK_RESUME_PROMPT:-Ночная автономная работа прервалась (кончился лимит или оборвалась связь), \
сейчас можно продолжать. Прочитай PLAN.md, JOURNAL.md, BLOCKED.md и посмотри git log и git status, \
чтобы понять, на чём остановились. Продолжай с этого места по правилам AFK: виток цикла — шаг, критик, \
правка, запись в JOURNAL.md, и каждый виток трогай .afk/heartbeat. Замкни работу скиллом loop, \
иначе всё встанет после первого же хода.}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --start)  ACTION=start; shift ;;
    --stop)   ACTION=stop; shift ;;
    --status) ACTION=status; shift ;;
    --once)   ACTION=once; shift ;;
    --daemon) ACTION=daemon; DRY=0; shift ;;
    --force)  DRY=0; shift ;;
    --dir)    DIR="$(readlink -f "$2")"; shift 2 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "afk-watch: неизвестный флаг $1" >&2; exit 2 ;;
  esac
done

[[ -n "$ACTION" ]] || ACTION=status

AFKDIR="$DIR/.afk"
STATE="$AFKDIR/watch.state"
LOGFILE="$AFKDIR/watch.log"

# printf, а не echo: иначе перевод строки превращается в лишний дефис в имени юнита.
SLUG="$(printf '%s' "$(basename "$DIR")" | tr -c 'A-Za-z0-9_-' '-')-$(printf '%s' "$DIR" | sha1sum | cut -c1-8)"
UNIT="afk-watch-$SLUG"

# Юнит ищем по каталогу в описании, а не только по имени: имя строится из пути,
# и любое изменение схемы (или переименование каталога) осиротило бы уже
# работающего сторожа — он остался бы жив, но снять его было бы нечем.
running_unit() {
  local u
  while read -r u; do
    [[ -n "$u" ]] || continue
    if systemctl --user show "$u" -p Description --value 2>/dev/null | grep -qF " в $DIR"; then
      printf '%s\n' "${u%.service}"
      return 0
    fi
  done < <(systemctl --user list-units 'afk-watch-*' --no-legend --plain 2>/dev/null | awk '{print $1}')
  return 1
}

# ── мелочи ────────────────────────────────────────────────────────────────────

say() { printf '%s\n' "$*"; }

# Событие: и в журнал сторожа, и на глаза (в daemon-режиме это уходит в journald).
log() {
  mkdir -p "$AFKDIR"
  printf '%s  %s\n' "$(date '+%d.%m %H:%M')" "$*" >> "$LOGFILE"
  say "$*"
}

state_get() { [[ -f "$STATE" ]] && sed -n "s/^$1=//p" "$STATE" | tail -1 || true; }

state_set() {
  mkdir -p "$AFKDIR"
  touch "$STATE"
  grep -v "^$1=" "$STATE" > "$STATE.tmp" 2>/dev/null || true
  printf '%s=%s\n' "$1" "$2" >> "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

state_num() { local v; v="$(state_get "$1")"; [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" || echo 0; }

now() { date +%s; }

# Возраст файла в секундах; несуществующего — заведомо большой.
age_of() { if [[ -e "$1" ]]; then echo $(( $(now) - $(stat -c %Y "$1") )); else echo 999999; fi; }

# Сессии Claude Code в этом каталоге, свежая первой: kind|pid|sessionId|status|startedAt|name
sessions() {
  claude agents --json 2>/dev/null | python3 -c '
import json, sys
target = sys.argv[1]
try:
    rows = [r for r in json.load(sys.stdin) if r.get("cwd") == target]
except Exception:
    rows = []
rows.sort(key=lambda r: r.get("startedAt") or 0, reverse=True)
for r in rows:
    print("|".join(str(r.get(k, "")) for k in ("kind", "pid", "sessionId", "status", "startedAt", "name")))
' "$DIR" 2>/dev/null || true
}

limits() {
  local near
  near="$(dirname "$SELF")/afk-limits"
  if [[ -x "$near" ]]; then "$near" --json 2>/dev/null || echo '{}'
  else afk-limits --json 2>/dev/null || echo '{}'; fi
}

# limit_field session percent — поле из вывода afk-limits, лежащего в $LIMITS
limit_field() {
  python3 -c '
import json, sys
try:
    data = json.loads(sys.argv[1]) or {}
    value = (data.get(sys.argv[2]) or {}).get(sys.argv[3])
    print("" if value is None else value)
except Exception:
    print("")
' "$LIMITS" "$1" "$2"
}

# Оборвалась ли сессия: Claude Code записывает такие срывы в журнал сессии
# отдельной пометкой (isApiErrorMessage). Печатает возраст обрыва в секундах,
# если после него сессия так ничего и не сделала.
session_broke() {
  local sid="$1"
  [[ -n "$sid" ]] || return 0
  local file
  file=$(find "$HOME/.claude/projects" -name "$sid.jsonl" -print -quit 2>/dev/null)
  [[ -n "$file" ]] || return 0
  python3 -c '
import json, sys, time
from datetime import datetime

last_error = None
try:
    with open(sys.argv[1]) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except Exception:
                continue
            if row.get("type") not in ("assistant", "user"):
                continue
            stamp = row.get("timestamp")
            if row.get("isApiErrorMessage"):
                last_error = stamp
            else:
                last_error = None
except Exception:
    sys.exit(0)

if last_error:
    broke = datetime.fromisoformat(last_error.replace("Z", "+00:00")).timestamp()
    print(int(time.time() - broke))
' "$file" 2>/dev/null || true
}

# Связь есть, если api.anthropic.com отвечает хоть чем-нибудь (адрес переопределяется
# через AFK_PING_URL — так проверяется поведение при обрыве).
online() { curl -s -o /dev/null -m 8 "${AFK_PING_URL:-https://api.anthropic.com/}" 2>/dev/null; }

journal() {
  local file="$DIR/JOURNAL.md"
  [[ -f "$file" ]] || return 0
  printf '\n- %s — сторож: %s\n' "$(date '+%H:%M')" "$1" >> "$file"
}

# ── пробуждение вставшей сессии ───────────────────────────────────────────────

# Оборванная сессия жива и ждёт ввода — ей достаточно что-нибудь написать.
# Сделать это можно, только если окно держит tmux: изнутри Claude Code писать
# в чужую сессию нельзя, а межсессионное сообщение ждёт подтверждения человека.
NUDGE_TEXT="${AFK_NUDGE_TEXT:-Связь оборвалась, работа встала. Продолжай по PLAN.md с того места, где остановился, и трогай .afk/heartbeat каждый виток.}"

nudge_session() {
  command -v tmux >/dev/null || return 1
  local target="afk-$(basename "$DIR")"
  tmux has-session -t "$target" 2>/dev/null || return 1
  if [[ "$DRY" == 1 ]]; then
    log "написал бы во вставшее окно tmux «$target»"
    return 0
  fi
  # Только текст и перевод строки. Escape тут опасен: он отменяет диалоги,
  # а на диалоге доверия к каталогу — просто закрывает Claude Code.
  tmux send-keys -t "$target" "$NUDGE_TEXT" 2>/dev/null || return 1
  tmux send-keys -t "$target" Enter 2>/dev/null || return 1
  state_set nudged "$(now)"
  log "написал во вставшее окно tmux «$target» — работа продолжится там же"
  journal "сессия разбужена в своём окне после обрыва"
  return 0
}

# ── подъём работы ─────────────────────────────────────────────────────────────

# Фоновая сессия переживает закрытый терминал, а утром `claude attach <id>`
# возвращает её человеку в окно.
start_session() {
  local sid="$1" why="$2" args=() out id verdict

  if [[ "$DRY" == 1 ]]; then
    log "поднял бы работу заново ($why), контекст ${sid:-с чистого листа}"
    return 0
  fi

  # Без автономности поднятая сессия немая: в dontAsk любая команда, требующая
  # разрешения, молча отклоняется, и работа не двигается.
  command -v afk-autonomy >/dev/null && afk-autonomy --on --dir "$DIR" >/dev/null 2>&1 || true

  args=(--bg --permission-mode "$MODE")
  [[ -f "$POLICY" ]] && args+=(--append-system-prompt-file "$POLICY")
  [[ -n "$sid" ]] && args+=(--resume "$sid")

  out=$(cd "$DIR" && claude "${args[@]}" "$RESUME_PROMPT" 2>&1 | head -3)
  id=$(grep -oE 'backgrounded · [0-9a-f]+' <<< "$out" | awk '{print $3}' || true)

  if [[ -z "$id" ]]; then
    log "поднять не вышло: $(head -1 <<< "$out")"
    return 1
  fi

  sleep 25
  verdict="$(claude agents --json --all 2>/dev/null | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except Exception:
    rows = []
for r in rows:
    if r.get("id") == sys.argv[1]:
        print("{}|{}".format(r.get("state", ""), r.get("sessionId", "")))
        break
' "$id" 2>/dev/null || true)"

  if [[ "${verdict%%|*}" == failed ]]; then
    if [[ -n "$sid" ]]; then
      log "сессия не поднялась с прежним контекстом, начинаю по PLAN.md"
      start_session "" "$why"
      return
    fi
    log "сессия $id упала сразу после запуска"
    return 1
  fi

  state_set resumes "$(( $(state_num resumes) + 1 ))"
  state_set last_resume "$(now)"
  [[ -n "${verdict#*|}" ]] && state_set resume_sid "${verdict#*|}"
  log "работа поднята заново ($why) — сессия $id, утром «claude attach $id»"
  journal "работа поднята заново ($why), сессия $id"
}

# Мягко закрыть то, что осталось от прежней сессии: две сессии в одном каталоге
# правят одни и те же файлы.
close_stalled() {
  local kind pid sid status started name closed=0
  while IFS='|' read -r kind pid sid status started name; do
    [[ -z "$kind" ]] && continue
    if [[ "$DRY" == 0 ]]; then
      if [[ "$kind" == background ]]; then
        claude stop "${sid:0:8}" >/dev/null 2>&1 || true
      elif [[ "$pid" =~ ^[0-9]+$ ]]; then
        kill -TERM "$pid" 2>/dev/null || true
      fi
    fi
    log "закрыл вставшую сессию ${sid:0:8} ($kind)"
    closed=1
  done < <(sessions)
  [[ "$DRY" == 0 && "$closed" == 1 ]] && sleep 3
  return 0
}

# ── проверка ──────────────────────────────────────────────────────────────────

SLEEP="$CHECK_SEC"
LIMITS='{}'

# 0 — следить дальше, 10 — сторожу закончить.
tick() {
  SLEEP="$CHECK_SEC"

  if [[ -e "$AFKDIR/stop" ]]; then
    log "работа закончена (.afk/stop), снимаюсь"
    return 10
  fi

  local watch_start hb kind pid sid status started name human=""
  watch_start="$(state_num started)"

  # Своя сессия человека, заведённая уже при живом стороже: ночные `afk` зовёт
  # «afk-<каталог>», у ручных имя другое. Пока такая рядом, сторож не поднимает
  # ничего — но и не снимается: вкладку могут закрыть через минуту, а ночь
  # останется без присмотра.
  while IFS='|' read -r kind pid sid status started name; do
    [[ "$kind" == interactive ]] || continue
    [[ "$name" == afk-* ]] && continue
    [[ "$started" =~ ^[0-9]+$ ]] || continue
    (( started / 1000 > watch_start + 60 )) && human="$name"
  done < <(sessions)

  if [[ -n "$human" ]]; then
    [[ "$(state_get paused)" == 1 ]] || log "рядом своя сессия «$human» — приостанавливаюсь, работу не трогаю"
    state_set paused 1
    return 0
  fi

  if [[ "$(state_get paused)" == 1 ]]; then
    log "своя сессия закрылась — снова слежу"
    state_set paused 0
  fi

  # Пока сессия на месте, помним её контекст: с ним же её и поднимать.
  sid="$(sessions | head -1 | cut -d'|' -f3)"
  [[ -n "$sid" && "$sid" != "$(state_get resume_sid)" ]] && state_set resume_sid "$sid"

  # Сессия занята работой — трогать её нельзя, что бы ни говорил heartbeat.
  # Один шаг (сборка, тесты, субагент, долгий ход) легко перекрывает порог
  # молчания, и раньше сторож убивал ровно ту работу, которую сторожил.
  if sessions | cut -d'|' -f4 | grep -qx busy; then
    say "сессия занята работой — не вмешиваюсь"
    return 0
  fi

  # Heartbeat может и не появиться — тогда отсчёт идёт от последнего события
  # самого сторожа: заступил или поднимал работу.
  # Явный обрыв виднее молчания: клиенту дают пять минут на свои повторы,
  # дальше сессия уже точно никуда не поедет.
  local broke
  broke="$(session_broke "$(state_get resume_sid)")"
  if [[ "$broke" =~ ^[0-9]+$ ]] && (( broke > 300 )); then
    if online; then
      # Разбудить в своём окне лучше, чем закрыть и поднять заново: остаются
      # и контекст, и окно, и Remote Control. Пробуем раз в четверть часа.
      local nudged
      nudged="$(state_num nudged)"
      if (( $(now) - nudged > 900 )) && nudge_session; then
        SLEEP=300
        return 0
      fi
      log "сессия оборвалась $(( broke / 60 )) мин назад (обрыв связи в журнале сессии) — поднимаю"
      close_stalled
      start_session "$(state_get resume_sid)" "оборвалась связь" || true
      return 0
    fi
    log "сессия оборвалась, но связи всё ещё нет — жду"
    SLEEP=120
    return 0
  fi

  # Пульса нет с тех пор, как сторож заступил, — значит в каталоге обычная рабочая
  # сессия, а не ночная. Тогда молчание ничего не значит (человек читает, думает,
  # вышел за кофе), и остаются два надёжных признака: явный обрыв выше и пропажа
  # сессии из списка.
  local hb_at
  hb_at=$(stat -c %Y "$AFKDIR/heartbeat" 2>/dev/null || echo 0)
  if (( hb_at <= watch_start )); then
    if [[ -z "$(sessions)" ]]; then
      log "сессии в каталоге не осталось — поднимаю работу"
      start_session "$(state_get resume_sid)" "сессия исчезла" || true
      return 0
    fi
    say "ночного пульса нет — слежу только за обрывами"
    return 0
  fi

  hb=$(age_of "$AFKDIR/heartbeat")

  if (( hb < IDLE_MIN * 60 )); then
    say "работа идёт, последний виток $(( hb / 60 )) мин назад"
    return 0
  fi

  if ! online; then
    log "связи нет — жду, работу не трогаю"
    SLEEP=120
    return 0
  fi

  LIMITS="$(limits)"
  local s_pct s_left w_pct
  s_pct="$(limit_field session percent)"
  s_left="$(limit_field session resets_in_sec)"
  w_pct="$(limit_field weekly percent)"

  # Пятичасовое окно выбрано — ждём сброса. Данные могли устареть, поэтому
  # прошедшее время сброса важнее процента.
  if [[ "$s_pct" =~ ^[0-9]+$ ]] && (( s_pct >= 97 )) && [[ "$s_left" =~ ^[0-9]+$ ]] && (( s_left > 0 )); then
    state_set hit_limit "$(now)"
    log "пятичасовое окно выбрано ($s_pct%), сброс через $(( s_left / 60 )) мин — жду"
    SLEEP=$(( s_left + 60 )); (( SLEEP > 1800 )) && SLEEP=1800
    return 0
  fi

  if [[ "$w_pct" =~ ^[0-9]+$ ]] && (( w_pct >= WEEKLY_FLOOR )); then
    log "недельный кап на исходе ($w_pct%) — не поднимаю, остаток оставляю человеку"
    journal "работа не возобновлена: недельный кап $w_pct%, оставил запас на утро"
    return 10
  fi

  local resumes last
  resumes="$(state_num resumes)"
  last="$(state_num last_resume)"

  if (( resumes >= MAX_RESUMES )); then
    log "поднимал уже $resumes раз — без человека дальше смысла нет, снимаюсь"
    journal "работа вставала $resumes раз, сторож снялся"
    return 10
  fi

  if (( $(now) - last < 900 )); then
    say "поднимал $(( ($(now) - last) / 60 )) мин назад, даю сессии время"
    return 0
  fi

  # Поднялась, но за всё это время не подала голоса — значит подъём не лечит:
  # чаще всего сессии не дают работать разрешения.
  if (( last > 0 )); then
    local hb_at dead
    hb_at=$(stat -c %Y "$AFKDIR/heartbeat" 2>/dev/null || echo 0)
    if (( hb_at < last )); then
      dead=$(( $(state_num dead_resumes) + 1 ))
      state_set dead_resumes "$dead"
      if (( dead >= 2 )); then
        log "поднятая сессия не подаёт признаков жизни — похоже, работать ей не дают разрешения (afk-autonomy --status); снимаюсь"
        journal "подъём не помогает: поднятая сессия молчит. Проверь «afk-autonomy --status» и подними работу сам"
        return 10
      fi
    else
      state_set dead_resumes 0
    fi
  fi

  local why="сессия молчит $(( hb / 60 )) мин"
  [[ -n "$(state_get hit_limit)" ]] && why="лимит открылся"

  # Сначала мягко: живой сессии в tmux достаточно написать. Закрываем только
  # если писать некуда или это уже не помогло.
  local nudged
  nudged="$(state_num nudged)"
  if (( $(now) - nudged > 900 )) && nudge_session; then
    state_set hit_limit ""
    SLEEP=300
    return 0
  fi

  close_stalled
  start_session "$(state_get resume_sid)" "$why" || true
  state_set hit_limit ""
  return 0
}

# ── действия ──────────────────────────────────────────────────────────────────

case "$ACTION" in
  start)
    if running_unit >/dev/null; then
      say "сторож уже приставлен к $DIR"
      exit 0
    fi
    mkdir -p "$AFKDIR"
    rm -f "$AFKDIR/stop"
    # Отсчёт молчания начинается сейчас: heartbeat мог остаться с прошлой ночи,
    # и без этого сторож с ходу решит, что живая сессия давно встала.
    touch "$AFKDIR/heartbeat"
    state_set started "$(now)"
    state_set resumes 0
    state_set last_resume 0
    state_set hit_limit ""
    state_set resume_sid "$(sessions | head -1 | cut -d'|' -f3)"

    # Служебные файлы сторожа не должны попадать в ночные коммиты.
    if [[ -d "$DIR/.git" ]] && ! grep -qs '^\.afk/$' "$DIR/.git/info/exclude"; then
      mkdir -p "$DIR/.git/info" && echo '.afk/' >> "$DIR/.git/info/exclude"
    fi

    # Текст, которым сторож будит и поднимает работу, задают снаружи: сессия
    # может жить не в каталоге проекта, и тогда «прочитай PLAN.md» ей ничего не даёт.
    ENV_ARGS=(
      --setenv="AFK_IDLE_MIN=$IDLE_MIN"
      --setenv="AFK_WEEKLY_FLOOR=$WEEKLY_FLOOR"
      --setenv="AFK_MAX_RESUMES=$MAX_RESUMES"
      --setenv="AFK_CHECK_SEC=$CHECK_SEC"
      --setenv="AFK_PERMISSION_MODE=$MODE"
      --setenv="PATH=$PATH"
    )
    [[ -n "${AFK_RESUME_PROMPT:-}" ]] && ENV_ARGS+=(--setenv="AFK_RESUME_PROMPT=$AFK_RESUME_PROMPT")
    [[ -n "${AFK_NUDGE_TEXT:-}" ]]    && ENV_ARGS+=(--setenv="AFK_NUDGE_TEXT=$AFK_NUDGE_TEXT")
    [[ -n "${AFK_POLICY:-}" ]]        && ENV_ARGS+=(--setenv="AFK_POLICY=$AFK_POLICY")
    [[ -n "${AFK_PING_URL:-}" ]]      && ENV_ARGS+=(--setenv="AFK_PING_URL=$AFK_PING_URL")

    systemd-run --user --unit "$UNIT" --collect \
      --description "Сторож ночной сессии Claude Code в $DIR" \
      "${ENV_ARGS[@]}" \
      systemd-inhibit --what=sleep:handle-lid-switch \
        --who=afk-watch --why="ночная работа Claude Code" \
        "$SELF" --daemon --dir "$DIR" >/dev/null
    say "сторож приставлен к $DIR: ждёт .afk/heartbeat, поднимает работу после лимита и обрыва связи."
    say "посмотреть — afk-watch --status, снять — afk-watch --stop"
    ;;

  stop)
    UNIT="$(running_unit || echo "$UNIT")"
    systemctl --user stop "$UNIT.service" 2>/dev/null || true
    systemctl --user reset-failed "$UNIT.service" 2>/dev/null || true
    say "сторож снят с $DIR"
    ;;

  status)
    if UNIT="$(running_unit)"; then
      say "сторож работает (юнит $UNIT)"
    else
      say "сторожа нет (юнит $UNIT не запущен)"
    fi
    hb=$(age_of "$AFKDIR/heartbeat")
    if (( hb == 999999 )); then say "heartbeat не появлялся"; else say "последний виток $(( hb / 60 )) мин назад"; fi
    broke="$(session_broke "$(state_get resume_sid)")"
    [[ "$broke" =~ ^[0-9]+$ ]] && say "сессия оборвана $(( broke / 60 )) мин назад и с тех пор молчит"
    resumes="$(state_num resumes)"
    (( resumes > 0 )) && say "работа поднималась заново $resumes раз"
    [[ -f "$LOGFILE" ]] && { say ""; tail -5 "$LOGFILE"; }
    ;;

  once)
    tick || true
    ;;

  daemon)
    log "сторож заступил: молчание дольше $IDLE_MIN мин — разбираюсь и поднимаю"
    while :; do
      set +e; tick; rc=$?; set -e
      (( rc == 10 )) && break
      sleep "$SLEEP"
    done
    log "сторож снялся"
    ;;
esac
